# =============================================
# 하이웍스 로그인 정보 (직접 수정 필요)
# 이 파일을 config.properties 로 복사한 뒤 값을 채우세요.
# config.properties 는 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.
# =============================================
hiworks.url=https://gw.hiworks.com/
hiworks.company=회사아이디
hiworks.username=아이디
hiworks.password=비밀번호

# =============================================
# 출퇴근 스케줄 설정 (Cron 표현식)
# 형식: 초 분 시 일 월 요일
# =============================================
# 평일(월~금) 오전 9시 정각에 실행
schedule.cron=0 0 9 ? * MON-FRI
# 재시도 간격 (초)
schedule.retry.interval=60
# 최대 재시도 횟수
schedule.retry.max=5

# =============================================
# 브라우저 설정
# =============================================
# true = 백그라운드 실행, false = 브라우저 창 표시
browser.headless=false
